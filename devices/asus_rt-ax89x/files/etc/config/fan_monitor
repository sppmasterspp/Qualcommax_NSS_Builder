config fan_monitor 'main'
	option debug '0'
	option interval_sec '15'
	option downshift_intervals '4'
	option sensor_fail_limit '3'
	option enable_thermal_zones '1'

	option off_rpm '0'
	option low_rpm '1600'
	option mid_rpm '1850'
	option max_rpm '2100'

	option cpu_low_up '62'
	option cpu_mid_up '66'
	option cpu_max_up '70'
	option cpu_low_down '59'
	option cpu_mid_down '63'
	option cpu_max_down '67'

	option aqr_low_up '65'
	option aqr_mid_up '74'
	option aqr_max_up '80'
	option aqr_low_down '62'
	option aqr_mid_down '72'
	option aqr_max_down '78'

	option wifi_low_up '68'
	option wifi_mid_up '73'
	option wifi_max_up '78'
	option wifi_low_down '65'
	option wifi_mid_down '70'
	option wifi_max_down '75'
