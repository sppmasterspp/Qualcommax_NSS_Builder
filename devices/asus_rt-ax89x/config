#################################################
# Target
#################################################

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_asus_rt-ax89x=y

#################################################
# Build
#################################################

CONFIG_KERNEL_BUILD_DOMAIN="proton.me"
CONFIG_KERNEL_BUILD_USER="sppmaster"
# CONFIG_KERNEL_KEYS is not set

#################################################
# BusyBox
#################################################

## edma-dump needs /dev/mem + the busybox devmem applet.
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_HISTORY=1024
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_VI=y
CONFIG_BUSYBOX_CONFIG_FEATURE_REVERSE_SEARCH=y

#################################################
# LuCI
#################################################

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y

CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-footstrap=y

CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-proto-wireguard=y

#################################################
# Networking
#################################################

CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_banip=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_pbr=y

CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_zerotier=y

#################################################
# File Sharing
#################################################

CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-avahi-service=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_avahi-dbus-daemon=y

#################################################
# Storage
#################################################

CONFIG_PACKAGE_block-mount=y

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_input-support=y

CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-hfs=y
CONFIG_PACKAGE_kmod-fs-hfsplus=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y

CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y

#################################################
# Monitoring
#################################################

CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-cpufreq=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y
CONFIG_PACKAGE_collectd-mod-sensors=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-wireless=y

#################################################
# Utilities
#################################################

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_speedtestcpp=y
